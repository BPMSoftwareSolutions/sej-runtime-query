      "failureDisposition": "WORKSPACE_REGISTRY_REQUEST_REJECTED",
      "requestFields": [
        { "name": "workspaceRoot", "type": "string", "required": true },
        { "name": "workspaceName", "type": "string", "required": false },
        { "name": "outputPath", "type": "string", "required": false },
        { "name": "persistenceMode", "type": "string", "required": true }
