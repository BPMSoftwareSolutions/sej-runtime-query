{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deterministic-solutions:applies-semantic-policy-overlay:input:v1",
  "title": "Applies semantic policy overlay input",
  "type": "object",
  "required": [
    "requestType",
    "requestId",
    "payload"
  ],
  "properties": {
    "requestType": {
      "const": "applies-semantic-policy-overlay-request.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "basePolicy",
        "overlay"
      ],
      "properties": {
        "basePolicy": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "overlay": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
