{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deterministic-solutions:projects-semantic-proof:input:v1",
  "title": "Projects semantic proof input",
  "type": "object",
  "required": [
    "requestType",
    "requestId",
    "payload"
  ],
  "properties": {
    "requestType": {
      "const": "projects-semantic-proof-request.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "requiredAssertions",
        "testimony"
      ],
      "properties": {
        "requiredAssertions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "testimony": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
