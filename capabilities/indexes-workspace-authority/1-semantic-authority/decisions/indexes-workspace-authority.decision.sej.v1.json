{
  "declarationType": "decision.v1",
  "decisionId": "resolves-authority-index-scope",
  "inputs": [
    "$.payload.explicitPaths",
    "$.payload.declaredRoots"
  ],
  "rules": [
    {
      "ruleId": "index-explicit-paths",
      "when": {
        "operator": "exists",
        "operand": {
          "kind": "path",
          "path": "$.payload.explicitPaths"
        }
      },
      "then": "index-explicit-paths"
    },
    {
      "ruleId": "index-declared-roots",
      "when": {
        "operator": "exists",
        "operand": {
          "kind": "path",
          "path": "$.payload.declaredRoots"
        }
      },
      "then": "index-declared-roots"
    }
  ],
  "noMatchDisposition": "reject",
  "implicitFallback": "forbidden"
}
