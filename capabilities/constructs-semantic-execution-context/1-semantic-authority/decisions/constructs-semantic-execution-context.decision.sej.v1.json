{
  "declarationType": "decision.v1",
  "decisionId": "resolves-execution-context-completeness",
  "inputs": [
    "$.missingBindingCount"
  ],
  "rules": [
    {
      "ruleId": "reject-incomplete-context",
      "when": {
        "operator": "greater-than",
        "left": {
          "kind": "path",
          "path": "$.missingBindingCount"
        },
        "right": {
          "kind": "value",
          "value": 0
        }
      },
      "then": "reject-incomplete-context"
    },
    {
      "ruleId": "context-complete",
      "when": {
        "operator": "always"
      },
      "then": "context-complete"
    }
  ],
  "noMatchDisposition": "reject",
  "implicitFallback": "forbidden"
}
