{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deterministic-solutions:constructs-semantic-execution-context:input:v1",
  "title": "Constructs semantic execution context input",
  "type": "object",
  "required": [
    "requestType",
    "requestId",
    "payload"
  ],
  "properties": {
    "requestType": {
      "const": "constructs-semantic-execution-context-request.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "requiredBindings",
        "providedBindings"
      ],
      "properties": {
        "requiredBindings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "providedBindings": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
