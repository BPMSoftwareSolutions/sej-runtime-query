        "persistenceMode"
      ],
      "properties": {
        "workspaceRoot": {
          "type": "string",
          "minLength": 1
        },
        "workspaceName": {
          "type": "string",
          "minLength": 1
        },
        "outputPath": {
          "type": "string",
          "minLength": 1
        },
        "persistenceMode": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-scaffold-status": "drafted"
}
