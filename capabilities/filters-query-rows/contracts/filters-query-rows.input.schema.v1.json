{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deterministic-solutions:filters-query-rows:input:v1",
  "title": "Filters query rows input",
  "type": "object",
  "required": [
    "requestType",
    "requestId",
    "payload"
  ],
  "properties": {
    "requestType": {
      "const": "filters-query-rows-request.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "rows"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "predicate": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
