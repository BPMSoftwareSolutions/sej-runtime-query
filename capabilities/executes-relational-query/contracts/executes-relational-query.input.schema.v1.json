{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deterministic-solutions:executes-relational-query:input:v1",
  "title": "Executes relational query input",
  "type": "object",
  "required": ["requestType", "requestId", "payload"],
  "properties": {
    "requestType": { "const": "executes-relational-query-request.v1" },
    "requestId": { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "required": ["commandText", "sources"],
      "properties": {
        "commandText": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
