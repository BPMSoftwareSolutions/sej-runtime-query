{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deterministic-solutions:executes-relational-query:receipt:v1",
  "title": "Executes relational query receipt",
  "type": "object",
  "required": [
    "receiptType", "runId", "capabilityId", "authorityHash", "inputHash",
    "resultHash", "decisionId", "resolvedRule", "disposition", "findings"
  ],
  "properties": {
    "receiptType": { "const": "executes-relational-query-receipt.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "capabilityId": { "const": "executes-relational-query" },
    "authorityHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "inputHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "resultHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "decisionId": { "const": "resolves-relational-query-execution-authority" },
    "resolvedRule": { "type": ["string", "null"] },
    "disposition": { "enum": ["RELATIONAL_QUERY_EXECUTED", "RELATIONAL_QUERY_REJECTED"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["findingId"],
        "properties": { "findingId": { "type": "string", "minLength": 1 }, "detail": {} },
        "additionalProperties": false
      }
    },
    "result": {}
  },
  "additionalProperties": false
}
