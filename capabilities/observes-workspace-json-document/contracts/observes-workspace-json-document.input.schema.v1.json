{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deterministic-solutions:observes-workspace-json-document:input:v1",
  "title": "Observe workspace JSON document input",
  "type": "object",
  "required": [
    "requestType",
    "requestId",
    "payload"
  ],
  "properties": {
    "requestType": {
      "const": "observes-workspace-json-document-request.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "workspaceRoot",
        "relativePath",
        "maximumReadBytes"
      ],
      "properties": {
        "workspaceRoot": {
          "type": "string",
          "minLength": 1
        },
        "relativePath": {
          "type": "string",
          "minLength": 1
        },
        "maximumReadBytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-scaffold-status": "drafted"
}
