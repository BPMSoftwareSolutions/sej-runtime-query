{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deterministic-solutions:lints-semantic-authority:input:v1",
  "title": "Lints semantic authority input",
  "type": "object",
  "required": [
    "requestType",
    "requestId",
    "payload"
  ],
  "properties": {
    "requestType": {
      "const": "lints-semantic-authority-request.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "declaration"
      ],
      "properties": {
        "declaration": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
