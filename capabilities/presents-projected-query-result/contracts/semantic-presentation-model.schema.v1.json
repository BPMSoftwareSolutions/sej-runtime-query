{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-presentation-model.v1",
  "type": "object",
  "required": [
    "presentationModelType",
    "resultContractId",
    "layoutShapeId",
    "bindingId",
    "regions"
  ],
  "additionalProperties": false,
  "properties": {
    "presentationModelType": { "const": "semantic-presentation-model.v1" },
    "resultContractId": { "type": "string", "minLength": 1 },
    "layoutShapeId": { "type": "string", "minLength": 1 },
    "bindingId": { "type": "string", "minLength": 1 },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["regionId", "content"],
        "additionalProperties": false,
        "properties": {
          "regionId": { "type": "string", "minLength": 1 },
          "content": { "type": "array" }
        }
      }
    }
  }
}
