{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deterministic-solutions:builds-workspace-registry:input:v1",
  "title": "Build workspace registry input",
  "type": "object",
  "required": [
    "requestType",
    "requestId",
    "payload"
  ],
  "properties": {
    "requestType": {
      "const": "builds-workspace-registry-request.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "workspaceRoot",
        "persistenceMode"
      ],
      "properties": {
        "workspaceRoot": {
          "type": "string",
          "minLength": 1
        },
        "workspaceName": {
          "type": "string",
          "minLength": 1
        },
        "outputPath": {
          "type": "string",
          "minLength": 1
        },
        "persistenceMode": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-scaffold-status": "drafted"
}
