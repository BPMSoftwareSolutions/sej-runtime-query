{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deterministic-solutions:selects-query-facts:input:v1",
  "title": "Selects query facts input",
  "type": "object",
  "required": [
    "requestType",
    "requestId",
    "payload"
  ],
  "properties": {
    "requestType": {
      "const": "selects-query-facts-request.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "rows"
      ],
      "properties": {
        "selectAll": {
          "type": "boolean"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "sourcePath"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "sourcePath": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
