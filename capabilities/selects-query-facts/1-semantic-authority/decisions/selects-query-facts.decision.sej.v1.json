{
  "declarationType": "decision.v1",
  "decisionId": "resolves-fact-selection-mode",
  "inputs": [
    "$.payload.selectAll",
    "$.payload.columns"
  ],
  "rules": [
    {
      "ruleId": "select-all-declared-facts",
      "when": {
        "operator": "truthy",
        "operand": {
          "kind": "path",
          "path": "$.payload.selectAll"
        }
      },
      "then": "select-all-declared-facts"
    },
    {
      "ruleId": "select-named-facts",
      "when": {
        "operator": "exists",
        "operand": {
          "kind": "path",
          "path": "$.payload.columns"
        }
      },
      "then": "select-named-facts"
    }
  ],
  "noMatchDisposition": "reject",
  "implicitFallback": "forbidden"
}
