{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deterministic-solutions:chains-semantic-results:input:v1",
  "title": "Chains semantic results input",
  "type": "object",
  "required": [
    "requestType",
    "requestId",
    "payload"
  ],
  "properties": {
    "requestType": {
      "const": "chains-semantic-results-request.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "producedContractId",
        "acceptedContractId",
        "producedValue"
      ],
      "properties": {
        "producedContractId": {
          "type": "string",
          "minLength": 1
        },
        "acceptedContractId": {
          "type": "string",
          "minLength": 1
        },
        "producedValue": {}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
