{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deterministic-solutions:resolves-kernel-compatibility:input:v1",
  "title": "Resolves kernel compatibility input",
  "type": "object",
  "required": [
    "requestType",
    "requestId",
    "payload"
  ],
  "properties": {
    "requestType": {
      "const": "resolves-kernel-compatibility-request.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "requiredPrimitives",
        "seatedPrimitives",
        "specificationVersion",
        "supportedSpecifications"
      ],
      "properties": {
        "requiredPrimitives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "seatedPrimitives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "specificationVersion": {
          "type": "string",
          "minLength": 1
        },
        "supportedSpecifications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
