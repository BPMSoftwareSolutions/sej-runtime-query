{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deterministic-solutions:joins-semantic-authority:input:v1",
  "title": "Joins semantic authority input",
  "type": "object",
  "required": [
    "requestType",
    "requestId",
    "payload"
  ],
  "properties": {
    "requestType": {
      "const": "joins-semantic-authority-request.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "left",
        "right",
        "joinKind"
      ],
      "properties": {
        "left": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "right": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "joinKey": {
          "type": "string",
          "minLength": 1
        },
        "joinKind": {
          "enum": [
            "inner",
            "left-outer"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
