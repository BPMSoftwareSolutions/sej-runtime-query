{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deterministic-solutions:resolves-query-source:input:v1",
  "title": "Resolves query source input",
  "type": "object",
  "required": [
    "requestType",
    "requestId",
    "payload"
  ],
  "properties": {
    "requestType": {
      "const": "resolves-query-source-request.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "sourceKind",
        "sourceHash"
      ],
      "properties": {
        "explicitSourceId": {
          "type": "string",
          "minLength": 1
        },
        "workspaceDefaultSourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceKind": {
          "type": "string",
          "minLength": 1
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^sha256:"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
